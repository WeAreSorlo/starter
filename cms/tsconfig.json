{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // While the packages are linked from ../../cms, so @sorlo/cms takes this project's flydrive
    "preserveSymlinks": true
  },
  "include": ["sorlo.config.ts", "migrations"]
}
