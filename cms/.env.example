# The CMS's settings in development. `npm run setup` copies this to .env, which sorlo reads, and fills in
# PREVIEW_SECRET. In production, the host's environment holds them instead.

# Postgres: the database compose.yaml makes
DATABASE_URL=postgres://sorlo:sorlo@localhost:5432/sorlo_starter
# The admin's public address, which emailed links and file URLs start from
APP_URL=http://localhost:4100
# The site, which the editor's Preview button opens
WEB_URL=http://localhost:3000
# Preview addresses carry it and the site's /api/preview checks it, so web/.env.local has the same one
PREVIEW_SECRET=

# A bucket for media, as production needs. With S3_BUCKET set, uploads go there rather than to storage/
# S3_BUCKET=
# S3_REGION=
# S3_KEY=
# S3_SECRET=
# For R2, MinIO and other services that speak S3
# S3_ENDPOINT=

# Email through any SMTP service, such as smtps://user:password@smtp.example.com
# SMTP_URL=
# MAIL_FROM=Example <cms@example.com>

# The key of the AI provider the admin's assistant uses, under the name its package reads, which npm create sorlo
# writes below
