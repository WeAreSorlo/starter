# The site's settings in development. `npm run setup` copies this to .env.local, which Next reads, and fills in
# PREVIEW_SECRET, the two keys and SORLO_WEBHOOK_SECRET. In production, the host's environment holds them instead.

# The CMS, which the site reads and visitors' browsers send the contact form to
SORLO_URL=http://localhost:4100
# A key for what's live. Setup's also has the types permission, for `npm run types`
SORLO_TOKEN=
# A key with the preview permission, for draft mode, which stays on the server
SORLO_PREVIEW_TOKEN=
# The same as the CMS's, which the editor's Preview button sends to /api/preview
PREVIEW_SECRET=
# The secret the "Revalidate the site" automation signs its requests with. Setup makes one and gives the imported
# automation the same, and in production it's the one the admin shows on the automation
SORLO_WEBHOOK_SECRET=
